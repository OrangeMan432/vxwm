#!/bin/sh
# Restart the river session that runs vxrwm.

arg="${1:-}"

if [ "$arg" != "-h" ]; then
	echo "Run rvx -h for help"
fi

if [ "$arg" = "-d" ]; then
	echo "rvx: restarting the river session with dbus-run-session"
	setsid sh -c 'sleep 2; exec dbus-run-session river -c vxrwm' >/dev/null 2>&1 &
	killall river
elif [ "$arg" = "-h" ]; then
	echo "rvx:     A tool designed for quickly restarting the river session running vxrwm"
	echo "rvx -d:  Restarts the session with dbus-run-session"
	echo "rvx -h:  Show this message"
else
	echo "rvx: restarting the river session"
	setsid sh -c 'sleep 2; exec river -c vxrwm' >/dev/null 2>&1 &
	killall river
fi
